[Unit]
Description=d4research - workspace for research across coding agents
ConditionPathExists=%h/.local/share/d4research/current/apps/server/dist/bin.mjs
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/.local/share/d4research/current
# Bind to loopback only; a local reverse proxy may expose it deliberately.
Environment=T3CODE_HOST=127.0.0.1
Environment=T3CODE_PORT=3773
Environment=T3CODE_NO_BROWSER=1
Environment="PATH=%h/.local/bin:%h/go/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env node %h/.local/share/d4research/current/apps/server/dist/bin.mjs
# Provider sessions and SQLite checkpoints need longer than the workstation's
# ten-second manager default to close cleanly during a production restart.
TimeoutStopSec=45s
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
