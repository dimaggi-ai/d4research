# Optional browser override for Mission Control voice. Leave unset to use the
# local service at http://127.0.0.1:8093.
# VITE_VOICE_GATEWAY_URL=https://voice.example.com

# Optional local memory connector. The URL can also be changed in
# Settings → Connections.
# T3CODE_LOCAL_MEMO_URL=http://127.0.0.1:8099

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
