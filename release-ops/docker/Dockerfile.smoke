# P0 distribution smoke environment: a clean machine as a container.
# The image build itself is the clean-install test — `npm install -g` of the
# packed artifact on a stock Node image with no repo checkout present.
FROM node:24-bookworm

WORKDIR /smoke

# The packed server artifact (npm pack of apps/server), staged by smoke.sh.
COPY d4research-artifact.tgz /smoke/d4research-artifact.tgz

# Clean install: declared dependencies resolve from the registry, native
# modules (node-pty) compile with the stock toolchain, and the `d4research` bin lands
# on PATH. A failure here fails the image build, which fails the smoke.
RUN npm install -g /smoke/d4research-artifact.tgz

COPY container-smoke.sh /smoke/container-smoke.sh
RUN chmod +x /smoke/container-smoke.sh

ENTRYPOINT ["/smoke/container-smoke.sh"]
