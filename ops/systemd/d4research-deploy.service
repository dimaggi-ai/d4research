[Unit]
Description=Validate, build, restart, and verify the local d4research deployment
After=network-online.target mission-control.service
Wants=network-online.target mission-control.service

[Service]
Type=oneshot
WorkingDirectory=%h/workspace/github/d4research
Environment="PATH=%h/.vite-plus/bin:%h/.nvm/versions/node/v24.18.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/workspace/github/d4research/scripts/deploy-local.sh
# Individual steps enforce tighter limits and emit 10-second heartbeats. This
# outer limit only prevents the complete validation/build/restart sequence from
# surviving all of its own deadlines.
TimeoutStartSec=6min
Nice=5
