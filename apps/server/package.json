{
  "name": "d4research",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimaggi-ai/d4research",
    "directory": "apps/server"
  },
  "bin": {
    "d4research": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "build:bundle": "vp pack",
    "build:exe": "node scripts/cli.ts build-exe",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc-rs --noEmit",
    "test": "vp test run",
    "record:codex-replay": "bun scripts/record-codex-app-server-replay-fixture.ts",
    "record:claude-replay": "bun scripts/record-claude-agent-sdk-replay-fixture.ts",
    "record:cursor-replay": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/record-cursor-agent-sdk-replay-fixture.ts",
    "record:pi-replay": "node scripts/record-pi-rpc-replay-fixture.ts",
    "record:grok-replay": "node scripts/record-grok-acp-replay-fixture.ts",
    "record:muse-replay": "node scripts/record-muse-msp-replay-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@cursor/sdk": "1.0.35",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@ff-labs/fff-node": "0.11.0",
    "@muse-code/sdk": "1.4.6",
    "@napi-rs/keyring": "^1.3.0",
    "@opencode-ai/sdk": "^1.3.15",
    "@d4research/provider-acp": "workspace:*",
    "@d4research/provider-acp-registry": "workspace:*",
    "@d4research/provider-core": "workspace:*",
    "@d4research/provider-cursor": "workspace:*",
    "@d4research/provider-grok": "workspace:*",
    "@d4research/provider-muse": "workspace:*",
    "@d4research/provider-opencode": "workspace:*",
    "@d4research/provider-pi": "workspace:*",
    "@d4research/source-control-azure-devops": "workspace:*",
    "@d4research/source-control-bitbucket": "workspace:*",
    "@d4research/source-control-core": "workspace:*",
    "@d4research/source-control-forgejo": "workspace:*",
    "@d4research/source-control-gitcafe": "workspace:*",
    "@d4research/source-control-github": "workspace:*",
    "@d4research/source-control-gitlab": "workspace:*",
    "effect": "catalog:",
    "jose": "catalog:",
    "node-pty": "^1.2.0-beta.15",
    "playwright-core": "1.60.0",
    "proper-lockfile": "4.1.2",
    "stream-chain": "^4.2.5",
    "stream-json": "3.6.0",
    "undici": "catalog:",
    "yaml": "catalog:",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@d4research/contracts": "workspace:*",
    "@d4research/provider-testing": "workspace:*",
    "@d4research/shared": "workspace:*",
    "@d4research/source-control-testing": "workspace:*",
    "@d4research/ssh": "workspace:*",
    "@d4research/tailscale": "workspace:*",
    "@d4research/web": "workspace:*",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "^3.4.0",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
